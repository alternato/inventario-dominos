    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.1",
    "vite-plugin-pwa": "^1.2.0",
